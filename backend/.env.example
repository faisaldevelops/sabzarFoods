# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=your_mongodb_connection_string

# Redis
UPSTASH_REDIS_URL=your_upstash_redis_url

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Gupshup WhatsApp Configuration (Template Messages Only)
# Get these from your Gupshup dashboard: https://www.gupshup.io/
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_SOURCE_NUMBER=919876543210
GUPSHUP_OTP_TEMPLATE_ID=c6aecef6-bcb0-4fb1-8100-28c094e3bc6b

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Client URL (Frontend URL for redirects and CORS)
CLIENT_URL=http://localhost:5173
